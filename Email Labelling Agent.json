    {
      "parameters": {
        "inputText": "={{ $json.text }}",
        "categories": {
          "categories": [
            {
              "category": "Advetisements",
              "description": "Classify an email as \"Advertisements\" if it:  \nPromotes a product, service, subscription, or event  \nContains marketing language such as offers, discounts, deals, limited-time promotions  \nEncourages purchasing, upgrading, subscribing, or registering for commercial purposes \nIs a sales outreach, promotional campaign, or sponsored content  \n\nExamples:  \nDiscount announcements  \nSaaS upgrade promotions  \nCorporate sales offers  \nProduct launches  \nE-commerce marketing emails"
            },
            {
              "category": "Education",
              "description": "Classify an email as \"Education\" if it:\nIs related to academic institutions, universities, or schools\nMentions enrollment, courses, certifications, exams, or training programs\nContains learning materials, class schedules, academic notifications, or student portals\nIs from an educational platform or training provider\n\nExamples:\nCourse enrollment confirmations\nSemester notifications\nCertification program announcements\nTraining reminders"
            },
            {
              "category": "Login Alerts",
              "description": "Classify an email as \"Login Alerts\" if it:\nNotifies about account login activity\nMentions password changes or security updates\nContains suspicious login alerts or device/location login information\nRequests password reset or security verification\nIs clearly related to account security monitoring\n\nExamples:\nNew login detected\nPassword updated confirmation\nSecurity warning\nAccount verification alerts"
            },
            {
              "category": "Others",
              "description": "Classify an email as \"Others\" if it:\nIs general business communication\nContains meeting invitations or project discussions\nIncludes internal team communication\nIs not promotional, educational, or security-related\nDoes not strongly match any of the above categories\n\nExamples:\nMeeting confirmations\nInternal updates\nProfessional correspondence\nProject discussions"
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Return ONLY one of the following exact labels:\nAdvertisements\nEducation\nLogin Alerts\nOthers\nDo not include explanations.\nDo not add extra text.\nDo not return multiple labels.\nChoose the single most appropriate category.\nIf the email contains overlapping themes, classify based on its primary intent."
        }
      },
